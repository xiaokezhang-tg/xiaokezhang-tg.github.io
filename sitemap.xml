---
layout: none
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd" xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- for page in site.pages -%}
  {%- unless page.sitemap == false or page.hidden -%}
  {%- unless page.url contains '/tag/' or page.url contains '/category/' or page.url contains '/page/' or page.url contains '/blog/20' or page.url contains '/books/20' -%}
  <url>
    <loc>{{ site.url }}{{ page.url | replace:'index.html','' }}</loc>
    {%- if page.last_modified_at %}<lastmod>{{ page.last_modified_at | date_to_xmlschema }}</lastmod>{%- elsif page.date %}<lastmod>{{ page.date | date_to_xmlschema }}</lastmod>{%- endif %}
  </url>
  {%- endunless -%}
  {%- endunless -%}
  {%- endfor -%}
  {%- for post in site.posts -%}
  {%- unless post.sitemap == false or post.hidden -%}
  <url>
    <loc>{{ site.url }}{{ post.url }}</loc>
    {%- if post.last_modified_at %}<lastmod>{{ post.last_modified_at | date_to_xmlschema }}</lastmod>{%- elsif post.date %}<lastmod>{{ post.date | date_to_xmlschema }}</lastmod>{%- endif %}
  </url>
  {%- endunless -%}
  {%- endfor -%}
  {%- for collection in site.collections -%}
  {%- unless collection.label == 'posts' -%}
  {%- for doc in collection.docs -%}
  {%- unless doc.sitemap == false or doc.hidden -%}
  <url>
    <loc>{{ site.url }}{{ doc.url }}</loc>
    {%- if doc.last_modified_at %}<lastmod>{{ doc.last_modified_at | date_to_xmlschema }}</lastmod>{%- elsif doc.date %}<lastmod>{{ doc.date | date_to_xmlschema }}</lastmod>{%- endif %}
  </url>
  {%- endunless -%}
  {%- endfor -%}
  {%- endunless -%}
  {%- endfor -%}
</urlset>
